# Protocol
# (annealing, (pre)optimization, clustering, separated by "," or ".")

.asc,
--maxprint,
r3 --concurrent=3,
opt --concurrent=8 input1,
cosmic -j4,
ref --concurrent=2 input2,
cosmic --th=opt -j4,
eref input3,
cosmic --th=opt -j4

#xtb input1
#name
#rescue(GFN2-xTB/freq)
